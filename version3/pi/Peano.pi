module Peano where

Nat : Type 
Nat = (x : Type) -> x -> (x -> x) -> x

zero : Nat
zero = \t. \v. \s. v

succ : Nat -> Nat
succ = \n. \t. \v. \s. s (n t v s) 

add : Nat -> Nat -> Nat
add = \a. \b. \t. \z. \s. a t (b t z s) s

mult : Nat -> Nat -> Nat
mult =  \a. \b. \t. \z. \s. a t z (\x. b t x s)

bool : Type
bool = (x : Type) -> x -> x -> x  

true : bool
true = \x. \y. \z. y

false : bool
false = \x. \y. \z. z

cond : bool -> (x : Type) -> x -> x -> x 
cond = \b. b

testCond : bool 
testCond = cond true bool true false
 
