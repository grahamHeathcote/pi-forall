module Test where

and : Type -> Type -> Type
and = \p. \q. (c : Type) -> (p -> q -> c) -> c

conj : (p : Type) -> (q : Type) -> p -> q -> and p q
conj = \p. \q. \a. \b. \c. \f. f a b  

proj1 : (p : Type) -> (q : Type) -> and p q -> p
proj1 = \p. \q. \a. a p (\x. \y. x)

proj2 : (p : Type) -> (q : Type) -> and p q -> q
proj2 = \p. \q. \a. a q (\x. \y. y)

aCom : (p : Type) -> (q : Type) -> and p q -> and q p
aCom = \p. \q. \a. conj q p  (proj2 p q a) (proj1 p q a)

aTran : (p : Type) -> (q : Type) -> and (and p q) p -> and p (and q p) 
aTran = \p. \q. \a. conj p (and q p) (proj2 (and p q) p a) (conj q p (proj2 p q (proj1 (and p q ) p a)) (proj2 (and p q) p a))

-- Attempt with sigma types

sigExample : Type
sigExample = {x : Type |}


