module NatChurch where

nat : Type

nat = (x:Type) -> x -> (x -> x) -> x
	 
z : nat
z = \x. \z. \s. z
	 
s : nat -> nat
s = \n. \x. \z. \s. s (n x z s)

one : nat
one = s z

two : nat
two = s (s z)

three : nat
three = s (two) 

plus : nat -> nat -> nat
plus = \x. \y. x nat y s

test0 : plus one one = two
test0 = Refl

test1 : plus one two = three
test1 = TRUSTME  -- replace with Refl

spec0 : (n : nat) -> plus z n = n
spec0 = \n . Refl

spec1 : (n : nat) -> (m : nat) -> plus (s n) m  = s (plus n m)
spec1 = \n m . Refl


