module Lecture1 where

import Nat
import BoolLib
import Fin


data Vec (A : Type) (n : Nat) : Type where
	Nil of [n = 0]
	Cons of (m : Nat) [n = Succ m] (A) (Vec A m)

vec0 : Vec Bool 0
vec0 = Nil

vec1 : Vec Bool 1
vec1 = Cons 0 True Nil

vec2 : Vec Bool 2
vec2 = Cons 1 True (Cons 0 False Nil)

map : (A : Type) -> (B : Type) -> (n : Nat) -> (f : A -> B) -> Vec A n -> Vec B n
map = \A. \B. \n. \f. \vec.
	case vec of
		Nil -> Nil
		Cons n x xs -> Cons n (f x) (map A B n f xs)

