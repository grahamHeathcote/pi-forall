module Graham2 where

import BoolLib

data Nat : Type where
	Zero
	Succ of (Nat)

isZero : Nat -> Bool
isZero = \n.
	case n of
		Zero -> True
		Succ (p) -> False


equals : (n : Nat) -> (m : Nat) -> Bool
equals = \n. \m.
	case n of
		Zero ->
			case m of
				Zero -> True
				Succ p -> False
		Succ pn ->
			case m of
				Zero -> False
				Succ pm -> equals pn pm

equalsTest : Bool
equalsTest = equals Zero Zero

greaterThan : (n : Nat) -> (m : Nat) -> Bool
greaterThan = \n. \m.
	case n of 
		Zero -> False
		Succ pn ->
			case m of
				Zero -> True
				Succ pm -> greaterThan pn pm

map : (n : Nat) -> Bool
map = \n.
	case n of 
		Zero -> True
		Succ p -> False




data Maybe (A : Type) : Type where
	Nothing
	Just of (A)

JustZero : Maybe Nat
JustZero = Just Zero


mapMaybe : (n : Maybe Nat) -> (Maybe Bool)
mapMaybe = \n.
	case n of
		Nothing -> Nothing
		Just x ->
			case x of
				Zero -> Just True
				Succ n -> Just False


				




